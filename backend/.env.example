# ===========================================================================
# ⚠️ 2026-09-22 升级提示：从旧版 .env 升级时必须删除以下三行
#
#     ECOM_MILVUS_HOST / ECOM_MILVUS_PORT / ECOM_DATABASE_URL
#
#   原因：这三项对应的配置已从 config/settings.py 删除（Milvus 与业务库
#   在代码里从来没有被使用过）。而 Settings 是 extra="forbid" 的 ——
#   留着它们会让服务【启动直接失败】，报错是：
#       ValidationError: ecom_milvus_host Extra inputs are not permitted
#
#   这是【故意】保留的严格模式，不是要放宽成 extra="ignore"：
#   静默忽略认不出的配置，意味着一个拼错的变量名（比如
#   ECOM_FEATURE_STORE_ENABLE 少个 D）不会报错、直接走默认值 ——
#   那正是 CLAUDE.md 里"静默读不到配置"那类最难查的坑。
#   宁可启动失败并明确指出是哪一项。
#
#   顺带：删除这三行之后，容器和本机的行为才一致 ——
#   docker compose 会用 env_file 读这个文件，多出来的键同样会让容器起不来。
# ===========================================================================

# LLM Configuration
ECOM_LLM_API_KEY=your_api_key_here
ECOM_LLM_BASE_URL=https://api.deepseek.com
ECOM_LLM_MODEL=deepseek-flash

# 推理开关（provider 相关，目前只对 DeepSeek 系生效）
#
# 实测（deepseek-flash）：该模型默认开启推理，output token 里 98.5% 是
# reasoning token；延迟与思考量的相关系数 r=0.997；max_tokens 被完全忽略。
# 对"选几个 ID""抽几个字段"这类确定性任务，推理只贡献延迟不贡献质量：
# 关掉后单次 9198ms -> 981ms，返回的商品 ID 逐项一致。
#
# 全链路实测：p50 从 48015ms 降到 4597ms（10.4 倍）。
# 创作型任务（营销文案）保留推理，见下面的例外名单。
ECOM_LLM_DISABLE_THINKING=true
# 例外名单：逗号分隔的 agent 名，这些【保留】推理。
# 默认为空 = 全部关闭推理。
# 实测（10 条用例）：保留 marketing_copy 的推理会让延迟涨 2.9 倍、成本涨 4.1 倍，
# 而 LLM 裁判评出的质量差异在 n=3 下不可测。所以默认不保留。
ECOM_LLM_THINKING_EXEMPT_AGENTS=

# ── Redis 实时特征（可选依赖）────────────────────────────────
# 开关默认 false：和 MCP 同一个理由 —— 新引入的外部依赖，
# 默认关闭 + 显式启用，保证现有链路零破坏。
#
# 打开前先灌行为数据，否则每个用户都会走"全新用户"分支：
#     python scripts/seed_behavior.py --reset
ECOM_FEATURE_STORE_ENABLED=false

# ⚠️ 用 127.0.0.1，不要用 localhost。
#    localhost 会先解析到 IPv6 的 ::1，而本机 Redis 只监听 IPv4 ——
#    连接会先在 ::1 上挂约 2 秒才回落。实测首次 PING：
#         localhost   2052.3 ms        127.0.0.1   2.4 ms
#    这个 2 秒大于请求路径的超时（0.5s），会把连接掐断、造成【永久降级】。
ECOM_REDIS_URL=redis://127.0.0.1:6379/0

# 特征读取超时（秒）。必须【小于】 agent_timeout_user_profile(5.0)，
# 让 Redis 先超时、画像 Agent 还有余量走 fallback。
# 稳态下单条命令约 0.3ms，0.5s 给得很宽；这个值防的是 Redis 卡死。
ECOM_FEATURE_STORE_TIMEOUT_S=0.5

# 购买计数的统计窗口（天）
ECOM_FEATURE_WINDOW_DAYS=30

# GC 用的 key 过期时间（秒），默认 30 天。
# ⚠️ TTL 不是窗口 —— EXPIRE 每次写入都会被刷新，只对"再也不来的用户"生效。
#    真正阻止 ZSET 无限增长的是写入时的 ZREMRANGEBYSCORE 修剪。
ECOM_FEATURE_TTL_SECONDS=2592000

# 算"活跃时段"用的时区偏移（小时）。必须显式固定：
# Dockerfile 是 python:3.12-slim 且没有 ENV TZ，容器里是 UTC、本机是 CST，
# 不固定会算出差 8 小时的 active_hours，而 LLM 照样拿它当"活跃时段"用。
ECOM_FEATURE_TZ_OFFSET_HOURS=8

# ── 接入层 ─────────────────────────────────────────────────────

# 日志格式。true = 逐行 JSON（给采集/排查用），false = 彩色控制台（本地读着舒服）。
#
# 为什么有这个开关：项目此前【从未】调用 structlog.configure()（原
# configure_logging() 在"删死代码"那轮被删了），于是文档里写的
# "结构化 JSON 日志"实际走的是默认彩色渲染。现在真的接上了。
ECOM_LOG_JSON=true

# 日志级别：DEBUG / INFO / WARNING / ERROR。默认 INFO。
#
# ⚠️ 它是【全局】过滤：设成 INFO 之后生产代码里那 3 处 logger.debug
#    就再也不输出了（tool.registered / mcp.tool_skipped_write /
#    harness/llm.py 的用量回填）。生产正要如此；而 tests/conftest.py
#    把它设成 DEBUG，否则"某个 debug 事件到底有没有发"在测试里无法回答。
ECOM_LOG_LEVEL=INFO

# `python main.py` 是否开热重载。默认 false。
# ⚠️ MCP 启用时【不要】开：reloader 重启会杀掉子进程树，MCP 的 stdio
#    子进程先死，症状是静默挂起或 BrokenPipe，没有栈指向真正原因。
#    本地改代码想要热重载时设 true（或用 start-python.bat 8000 reload）。
ECOM_DEV_RELOAD=false

# API Key 鉴权。**默认关闭** —— 和 MCP / 特征层同一个口径，
# 新增的准入控制默认不启用，保证现有链路零破坏。
# ⚠️ 打开前先想清楚：eval/runner.py 是走 HTTP 调服务做评测的，
#    开了鉴权它需要自己也会带 key，否则 12 条用例会集体 401。
ECOM_API_KEY_ENABLED=false
# 打开时必填。留空 + 开关为 true 会让【启动直接失败】——
# 这是有意的：一个配错的鉴权开关比没有鉴权更危险，它让人以为已经受保护了。
ECOM_API_KEY=
# 免鉴权路径（逗号分隔，精确匹配）。/health 必须在里面，
# 否则探活会被挡在门外，编排系统会认为服务已经死了。
ECOM_API_KEY_EXEMPT_PATHS=/health,/docs,/openapi.json,/redoc

# CORS 允许来源（逗号分隔）。默认是【开发期端口】，不是 "*"。
#
# 为什么默认值给这个而不是通配符：通配符在生产不可接受，而它恰恰是
# "忘了改"的最常见形态 —— 默认值应当落在安全的那一侧。
# 5173 = Vite dev server，4173 = Vite preview。
# 需要临时放开时显式写 ECOM_CORS_ALLOW_ORIGINS=*（会打一条 warning 日志）。
ECOM_CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# ── 限流 ───────────────────────────────────────────────────────
#
# **默认关闭**，同 ECOM_API_KEY_ENABLED 的理由：新能力默认不启用，
# 保证现有链路零破坏 —— 尤其 eval/runner.py 是串行快速连打做评测的，
# 默认开启会把它卡在 429 上，而症状看起来像"评测挂了"。
#
# 为什么值得开：推荐接口单次约 3 秒、成本约 $0.0005（实测）。
# 一个忘加 sleep 的 for 循环能在几分钟内烧掉可观额度，
# 而服务本身不会给出任何信号（只会看到延迟上升）。
ECOM_RATE_LIMIT_ENABLED=false

# 窗口内允许的请求数 / 窗口长度（秒）。默认 60 次 / 60 秒。
# 第一版给得宽 —— 目标是拦住"失控的循环"，不是把正常调用方卡住。
# 真正调参要基于实测流量，而那需要真实流量。
ECOM_RATE_LIMIT_REQUESTS=60
ECOM_RATE_LIMIT_WINDOW_S=60

# 免限流路径（逗号分隔，精确匹配）。
# /health 与 /ready 必须在里面 —— 探针被限流挡住，编排系统会认为
# 实例挂了并把它摘掉，而它其实好好的。
ECOM_RATE_LIMIT_EXEMPT_PATHS=/health,/ready,/docs,/openapi.json,/redoc

# ── 可观测 ─────────────────────────────────────────────────────
# 存活探针 GET /health：只说明进程活着，不检查任何依赖。
# 就绪探针 GET /ready ：说明实例此刻能否履行契约（检查流水线是否装配完），
#                      可选依赖的状态只汇报、不参与判断 —— 因为本系统的
#                      设计就是"外部依赖挂了也能降级交付"。
# 两者失败的含义不同：前者该重启，后者该等待。

# ── MCP ───────────────────────────────────────────────────────
# 两个开关都默认 false：这是一条新引入的外部依赖，
# 默认关闭 + 显式启用，保证现有链路零破坏。

# 是否把本项目的库存 Agent 接到 WMS MCP Server（而不是读 Product.stock）
# 打开前先初始化数据库：python mcp_servers/init_wms_db.py
ECOM_MCP_WMS_ENABLED=false

# 是否把推荐/指标能力注册为 MCP Server 供外部 Host 调用
ECOM_MCP_ENABLED=false

# WMS 的 SQLite 库路径。相对路径以 backend/ 目录为基准
# （config/settings.py 的 env_file=".env" 也是相对 cwd 解析的，所以要在 backend/ 下启动）。
ECOM_MCP_WMS_DB_PATH=./wms.db

# MCP 调用超时（秒）。必须【小于】 agent_timeout_inventory(5.0)，
# 这样 MCP 先超时、库存 Agent 还有余量走 fallback。
#
# 实测每次 MCP 调用约 1.15 秒（短连接要重启子进程，import mcp 本身约 1 秒），
# 所以 3.0s 给出约 2.6 倍余量。这也是为什么库存 Agent 必须用
# batch_query_stock 一次查完所有商品，而不是逐个查。
ECOM_MCP_WMS_TIMEOUT=3.0

# ── 成本核算（阶段 B）─────────────────────────────────────────
# token 数是从 API 响应读出的【事实】；价格是【配置】—— 会变，所以不硬编码。
# 内置表见 backend/harness/pricing.py，记了查证日期与来源链接。
#
# 查不到价格的模型会返回 cost_usd=null（而不是猜一个数）。
# 换 provider / 换模型时用下面任一方式覆盖：
#   ECOM_PRICING_FILE=/path/to/pricing.json
#   ECOM_PRICING_JSON={"my-model":{"input":1.0,"output":2.0,"cached_input":0.1}}
# 单位：美元 / 每百万 token
