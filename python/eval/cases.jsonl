{"id": "rec_001", "note": "基线用例：普通首页推荐", "request": {"user_id": "u_eval_001", "scene": "homepage", "num_items": 5}, "assert": {"min_products": 5, "require_agents_success": ["user_profile", "product_rec", "marketing_copy", "inventory"], "copies_cover_products": true, "no_forbidden_words": true, "max_latency_ms": 60000, "max_cost_usd": 0.05}}
{"id": "rec_002", "note": "只要 1 个商品（边界：最小值）", "request": {"user_id": "u_eval_002", "scene": "homepage", "num_items": 1}, "assert": {"min_products": 1, "copies_cover_products": true, "no_forbidden_words": true, "max_latency_ms": 60000, "max_cost_usd": 0.05}}
{"id": "rec_003", "note": "大量商品（边界：召回上限）", "request": {"user_id": "u_eval_003", "scene": "homepage", "num_items": 10}, "assert": {"min_products": 10, "copies_cover_products": true, "no_forbidden_words": true, "max_latency_ms": 90000, "max_cost_usd": 0.08}}
{"id": "rec_004", "note": "不同 scene", "request": {"user_id": "u_eval_004", "scene": "detail_page", "num_items": 3}, "assert": {"min_products": 3, "copies_cover_products": true, "no_forbidden_words": true, "max_latency_ms": 60000, "max_cost_usd": 0.05}}
{"id": "rec_005", "note": "带 context（行为数据兜底路径）", "request": {"user_id": "u_eval_005", "scene": "homepage", "num_items": 3, "context": {"recent_views": ["手机", "耳机"], "last_category": "耳机"}}, "assert": {"min_products": 3, "copies_cover_products": true, "no_forbidden_words": true, "max_latency_ms": 60000, "max_cost_usd": 0.05}}
{"id": "rec_006", "note": "长时间未活跃用户（分群边界）", "request": {"user_id": "u_churn_risk_006", "scene": "recall", "num_items": 5}, "assert": {"min_products": 5, "copies_cover_products": true, "no_forbidden_words": true, "max_latency_ms": 60000, "max_cost_usd": 0.05}}
{"id": "rec_007", "note": "新用户 ID（无历史）", "request": {"user_id": "brand_new_user_007", "scene": "homepage", "num_items": 5}, "assert": {"min_products": 5, "copies_cover_products": true, "no_forbidden_words": true, "max_latency_ms": 60000, "max_cost_usd": 0.05}}
{"id": "rec_008", "note": "高价值用户（VIP 模板分支）", "request": {"user_id": "u_vip_008", "scene": "homepage", "num_items": 3}, "assert": {"min_products": 3, "copies_cover_products": true, "no_forbidden_words": true, "max_latency_ms": 60000, "max_cost_usd": 0.05}}
{"id": "rec_009", "note": "同 ID 重复请求（验证结果稳定，非随机）", "request": {"user_id": "u_eval_001", "scene": "homepage", "num_items": 5}, "assert": {"min_products": 5, "copies_cover_products": true, "no_forbidden_words": true, "max_latency_ms": 60000, "max_cost_usd": 0.05}}
{"id": "rec_010", "note": "长 user_id（输入健壮性）", "request": {"user_id": "u_eval_010_with_a_very_long_identifier_for_robustness_testing", "scene": "homepage", "num_items": 3}, "assert": {"min_products": 3, "copies_cover_products": true, "no_forbidden_words": true, "max_latency_ms": 60000, "max_cost_usd": 0.05}}
